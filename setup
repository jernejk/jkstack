#!/usr/bin/env python3
"""Link this checkout's skills into selected harness directories."""
import argparse
import os
import sys
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    choice = parser.add_mutually_exclusive_group(required=True)
    choice.add_argument("--claude", action="store_true")
    choice.add_argument("--codex", action="store_true")
    choice.add_argument("--both", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent
    skills = sorted(p for p in (root / "skills").iterdir() if p.is_dir() and (p / "SKILL.md").is_file())
    if not skills:
        parser.error("no skills found in this checkout")
    targets = []
    if args.claude or args.both:
        targets.append(Path.home() / ".claude" / "skills")
    if args.codex or args.both:
        targets.append(Path.home() / ".agents" / "skills")
    plan, conflicts = [], []
    # Preflight the entire plan, including parents, before creating anything.
    for folder in targets:
        for parent in [folder.parent, folder]:
            if parent.is_symlink() or (parent.exists() and not parent.is_dir()):
                conflicts.append(f"target parent is a symlink or non-directory: {parent}")
        for source in skills:
            target = folder / source.name
            if target.is_symlink() and target.resolve() == source.resolve():
                print(f"already linked: {target}")
            elif os.path.lexists(target):
                conflicts.append(f"refusing existing path: {target}")
            else:
                plan.append((source, target))
    if conflicts:
        for conflict in conflicts:
            print(conflict, file=sys.stderr)
        return 1
    for source, target in plan:
        print(f"{'would link' if args.dry_run else 'link'}: {target} -> {source}")
        if not args.dry_run:
            target.parent.mkdir(parents=True, exist_ok=True)
            # symlink() fails if another process created the destination meanwhile.
            target.symlink_to(source, target_is_directory=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
